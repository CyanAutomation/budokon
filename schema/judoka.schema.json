{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://budokon.example/schema/judoka.schema.json",
  "title": "Judoka",
  "type": "object",
  "required": [
    "id",
    "slug"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "slug": {
      "$ref": "#/$defs/slug"
    },
    "aliases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/slug"
      },
      "uniqueItems": true
    },
    "signatureMoveId": {
      "$ref": "#/$defs/slug"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
