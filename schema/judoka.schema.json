{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://budokon.example/schema/judoka.schema.json",
  "title": "Canonical judoka",
  "type": "object",
  "required": ["id", "slug", "firstname", "surname", "personType", "countryCode", "weightClass", "category", "stats", "signatureMoveIds", "lastUpdated", "profileUrl", "bio", "gender", "isHidden", "rarity"],
  "properties": {
    "id": { "type": "string", "format": "uuid", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" },
    "slug": { "$ref": "#/$defs/slug" },
    "firstname": { "$ref": "#/$defs/text" },
    "surname": { "$ref": "#/$defs/text" },
    "personType": { "enum": ["real", "fictional"] },
    "countryCode": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "weightClass": { "type": "string", "pattern": "^[+-][0-9]{2,3}$" },
    "category": { "const": "Judo" },
    "stats": {
      "type": "object",
      "required": ["power", "speed", "technique", "kumikata", "newaza"],
      "properties": {
        "power": { "$ref": "#/$defs/stat" }, "speed": { "$ref": "#/$defs/stat" },
        "technique": { "$ref": "#/$defs/stat" }, "kumikata": { "$ref": "#/$defs/stat" },
        "newaza": { "$ref": "#/$defs/stat" }
      },
      "additionalProperties": false
    },
    "aliases": { "type": "array", "items": { "$ref": "#/$defs/alias" }, "uniqueItems": true },
    "legacySlugs": { "type": "array", "items": { "$ref": "#/$defs/slug" }, "uniqueItems": true },
    "signatureMoveIds": { "type": "array", "items": { "$ref": "#/$defs/slug" }, "minItems": 1, "uniqueItems": true },
    "lastUpdated": { "type": "string", "format": "date-time" },
    "profileUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "sourceUrls": {
      "type": "array",
      "items": { "type": "string", "format": "uri", "pattern": "^https://" },
      "minItems": 1,
      "uniqueItems": true
    },
    "bio": { "type": "string", "minLength": 20 },
    "gender": { "enum": ["male", "female"] },
    "isHidden": { "type": "boolean" },
    "rarity": { "enum": ["Common", "Rare", "Epic", "Legendary"] }
  },
  "additionalProperties": false,
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "alias": { "type": "string", "minLength": 1, "pattern": "^(?=.*[^a-z0-9-]).*\\S.*$" },
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "stat": { "type": "integer", "minimum": 0, "maximum": 10 }
  }
}
