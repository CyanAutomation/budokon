{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://budokon.example/schema/judoka.schema.json",
  "title": "Judoka",
  "type": "object",
  "required": [
    "id",
    "slug",
    "countryCode"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "slug": {
      "$ref": "#/$defs/slug"
    },
    "firstname": {
      "type": "string"
    },
    "surname": {
      "type": "string"
    },
    "countryCode": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "weightClass": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "stats": {
      "type": "object",
      "properties": {
        "power": { "type": "number" },
        "speed": { "type": "number" },
        "technique": { "type": "number" },
        "kumikata": { "type": "number" },
        "newaza": { "type": "number" }
      },
      "additionalProperties": false
    },
    "aliases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/slug"
      },
      "uniqueItems": true
    },
    "signatureMoveId": {
      "$ref": "#/$defs/slug"
    },
    "lastUpdated": {
      "type": "string",
      "format": "date-time"
    },
    "profileUrl": {
      "type": "string",
      "format": "uri"
    },
    "bio": {
      "type": "string"
    },
    "gender": {
      "type": "string"
    },
    "isHidden": {
      "type": "boolean"
    },
    "rarity": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
