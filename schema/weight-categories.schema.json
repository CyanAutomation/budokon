{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://budokon.example/schema/weight-categories.schema.json",
  "title": "Senior weight categories", "type": "array", "minItems": 2, "maxItems": 2,
  "items": {
    "type": "object", "required": ["gender", "description", "categories"],
    "properties": {
      "gender": { "enum": ["male", "female"] }, "description": { "type": "string", "minLength": 1 },
      "categories": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["weight", "descriptor"], "properties": { "weight": { "type": "string", "pattern": "^[+-][0-9]{2,3}$" }, "descriptor": { "type": "string", "minLength": 1 } }, "additionalProperties": false } }
    }, "additionalProperties": false
  }
}
