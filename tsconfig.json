{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"], "strict": true, "declaration": true,
    "outDir": "build/runtime", "rootDir": "src", "noEmitOnError": true,
    "verbatimModuleSyntax": true, "skipLibCheck": true
  },
  "include": ["src/**/*.ts"], "exclude": ["src/validation"]
}
