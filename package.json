{
  "name": "budokon-data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/runtime/index.d.ts",
      "import": "./build/runtime/index.js"
    },
    "./core": {
      "types": "./build/runtime/index.d.ts",
      "import": "./build/runtime/index.js"
    },
    "./node": {
      "types": "./build/runtime/node/load-json-read-model.d.ts",
      "import": "./build/runtime/node/load-json-read-model.js"
    },
    "./data": "./dist/budokon.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:data": "tsx scripts/build.ts",
    "typecheck": "npm run build && tsc -p tsconfig.tools.json",
    "check-artifacts": "tsx scripts/check-artifacts.ts",
    "check:typescript-only": "tsx scripts/check-typescript-only.ts",
    "coverage": "tsx scripts/coverage-report.ts",
    "verify-release": "tsx scripts/verify-release.ts",
    "validate": "tsx src/validation/validate-canonical.ts",
    "test": "npm run build && tsx --test scripts/*.test.ts tests/*.test.ts",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "wrangler": "^4.0.0"
  }
}
