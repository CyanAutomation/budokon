{
  "name": "budokon-data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.14.0 || >=24.10.0"
  },
  "exports": {
    ".": {
      "types": "./build/runtime/index.d.ts",
      "import": "./build/runtime/index.js"
    },
    "./core": {
      "types": "./build/runtime/index.d.ts",
      "import": "./build/runtime/index.js"
    },
    "./node": {
      "types": "./build/runtime/node/load-json-read-model.d.ts",
      "import": "./build/runtime/node/load-json-read-model.js"
    },
    "./data": "./dist/budokon.json"
  },
  "scripts": {
    "build": "npm run build:runtime",
    "build:runtime": "tsc -p tsconfig.json",
    "build:data": "tsx scripts/build.ts",
    "typecheck": "npm run build:runtime && npm run typecheck:tools",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "check-artifacts": "tsx scripts/check-artifacts.ts",
    "check:typescript-only": "tsx scripts/check-typescript-only.ts",
    "check:deployment-workflow": "tsx scripts/check-deployment-workflow.ts",
    "check": "npm run typecheck && npm run check:typescript-only && npm run test && npm run validate",
    "coverage": "tsx scripts/coverage-report.ts",
    "verify-release": "tsx scripts/verify-release.ts",
    "validate": "tsx src/validation/validate-canonical.ts",
    "validate:openapi": "ruby scripts/validate-openapi.rb",
    "validate:deployment-target": "tsx scripts/validate-cloudflare-deployment-target.ts",
    "smoke:deployment": "tsx scripts/smoke-deployment.ts",
    "test:validation:focused": "BUDOKON_SKIP_REPOSITORY_SMOKE=1 tsx --test tests/validation.test.ts",
    "test:validation:integration": "tsx --test --test-name-pattern='integration: canonical repository release gate' tests/validation.test.ts",
    "test": "npm run build && tsx --test scripts/*.test.ts tests/*.test.ts",
    "jev:evaluate": "tsx scripts/evaluate-jev.ts",
    "release": "tsx scripts/release.ts",
    "release:dry": "tsx scripts/release.ts --dry-run",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.5.4"
  }
}
