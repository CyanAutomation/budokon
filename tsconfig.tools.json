{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": false,
    // Override the base config so tooling also checks dependency declarations.
    "skipLibCheck": false
  },
  "include": [
    "src/**/*.ts",
    "worker/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "types/**/*.d.ts"
  ]
}
